# Cloudflare Turnstile (contact form + NDIS landing page)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD1vCNDGTonD85oz
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Supabase (required for admin/blogger auth and blog)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL used for password reset redirect links (must match Supabase Auth redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard setup for password reset OTP:
# 1. Authentication -> URL Configuration -> add redirect URLs:
#    - http://localhost:3000/auth/callback
#    - https://jschoicegroup.com.au/auth/callback
# 2. Authentication -> Email Templates -> Reset Password -> include: {{ .Token }}
